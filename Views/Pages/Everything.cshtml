@model ViewModel.EverythingPage_Everything
@{
    // Deterministic per-group accent. Deliberately not ColourPalette: that is a
    // process-wide mutable Stack, so concurrent requests interleave and a group's
    // colour changes on every render.
    var palette = new[] { "#CC3542", "#FA7902", "#FAB320", "#2CC6D2", "#0A98CF", "#065280" };

}
<!-- «Start| EverythingPage_Everything» -->
<form data-module="EverythingPage_Everything" method="post" action="@Url.Current()" class="everything">
    @Html.AntiForgeryToken()
    @Html.StartupActionsJson()
    <h2>What are you looking for?</h2>

    @if (Model.Groups.Any())
    {
        <div class="everything-search">
            @* The clear button overlays the input rather than sitting in an
               input-group-append: an empty append would still be :last-child and
               would square off the input's right corners whenever it is hidden. *@
            <div class="everything-search-box">
                <div class="input-group input-group-lg">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><i class="fas fa-search" aria-hidden="true"></i></span>
                    </div>
                    <input type="text" asp-for="FeatureSearch" class="form-control" autocomplete="off"
                           placeholder="Search all features..." aria-label="Search all features" />
                </div>
                <button type="button" class="btn everything-clear" aria-label="Clear search" hidden>
                    <i class="fas fa-times" aria-hidden="true"></i>
                </button>
            </div>
            <p class="everything-count text-muted" aria-live="polite"></p>
        </div>

        @* One column, in source order. The script below deals these into as many
           columns as the viewport allows, before the first paint. Rendering them
           pre-dealt would mean writing the same packing twice, in two languages,
           that had to stay identical. *@
        <div class="full-menu-container">
            <div class="everything-column">
                @for (var i = 0; i < Model.Groups.Count; i++)
                {
                var group = Model.Groups[i];
                <div class="everything-group" data-weight="@group.Weight" data-url="@group.SearchUrl"
                     style="--group-colour:@palette[i % palette.Length]">
                    <div class="full-menu-item card">
                        <div class="card-header d-flex align-items-center">
                            <i class="@group.Item.GetIcon() everything-group-icon" aria-hidden="true"></i>
                            @if (group.IsDisabled)
                            {
                                <span class="everything-group-title" data-title="@group.Item.Title">@group.Item.Title</span>
                            }
                            else
                            {
                                <a class="everything-group-title" href="@group.Url" data-title="@group.Item.Title">@group.Item.Title</a>
                            }
                            @if (group.TotalCount > 0)
                            {
                                <span class="badge badge-pill badge-light ml-auto" data-total="@group.TotalCount">@group.TotalCount</span>
                            }
                        </div>
                        @if (group.Children.Any())
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var node in group.Descendants())
                                {
                                    <li class="list-group-item everything-item everything-depth-@(Math.Min(node.Depth - 1, 2))"
                                        data-path="@node.Path" data-url="@node.SearchUrl">
                                        @if (node.IsDisabled)
                                        {
                                            <span class="everything-link disabled">
                                                <i class="@node.Item.GetIcon()" aria-hidden="true"></i>
                                                <span class="everything-title" data-title="@node.Item.Title">@node.Item.Title</span>
                                            </span>
                                        }
                                        else
                                        {
                                            @* Deliberately no badge-number / data-badgeurl here. hubPage binds
                                               BadgeNumber to $("a[data-badgeurl]") page-wide on load and again
                                               every 5 minutes; this page lists every feature the side menu
                                               already lists, so carrying badge urls would double the
                                               cross-service badge traffic on the app's home page. *@
                                            <a class="everything-link" href="@node.Url"
                                               @("data-redirect='ajax'".OnlyWhen(!node.Item.UseIframe && !node.Item.NoNav).TrustedRaw())>
                                                <i class="@node.Item.GetIcon()" aria-hidden="true"></i>
                                                <span class="everything-title" data-title="@node.Item.Title">@node.Item.Title</span>
                                            </a>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
                }
            </div>
        </div>

        <div class="empty-list everything-empty text-center" hidden>
            <i class="fas fa-search fa-2x d-block mb-3 text-muted" aria-hidden="true"></i>
            No features match <strong class="everything-empty-term"></strong>.
            <button type="button" class="btn btn-link everything-clear p-0 align-baseline">Clear the search</button>
        </div>
    }
    else
    {
        <div class="empty-list">
            There are no features to display.
        </div>
    }

    <script type="text/javascript">
    (function () {
        var container = document.querySelector('.full-menu-container');

        // The view renders every card in one column, largest first. Dealing them
        // into the final columns here rather than in razor keeps one copy of the
        // packing instead of two, in two languages, that had to stay identical.
        // Only the number of column wrappers decides the layout - each one is
        // flex: 1 1 0 - so the stylesheet never needs to know the count.
        var COLUMN_BREAKPOINTS = [
            { width: 2200, columns: 6 },
            { width: 1600, columns: 4 },
            { width: 1200, columns: 3 },
            { width: 768, columns: 2 }
        ];

        // Source order, captured before the first deal: once the cards are spread
        // across columns their dom order is column by column, which is not the
        // order the packing has to see.
        var ordered = container
            ? Array.prototype.slice.call(container.querySelectorAll('.everything-group'))
            : [];

        function targetColumns() {
            for (var i = 0; i < COLUMN_BREAKPOINTS.length; i++) {
                if (window.matchMedia('(min-width: ' + COLUMN_BREAKPOINTS[i].width + 'px)').matches) {
                    return COLUMN_BREAKPOINTS[i].columns;
                }
            }

            return 1;
        }

        function redeal() {
            if (!container) return;

            // An empty column still takes its share of the width, which would
            // bunch the cards up on the left.
            var target = Math.min(targetColumns(), ordered.length);
            if (!target) return;
            if (container.querySelectorAll('.everything-column').length === target) return;

            var columns = [], weights = [];
            for (var c = 0; c < target; c++) {
                var column = document.createElement('div');
                column.className = 'everything-column';
                columns.push(column);
                weights.push(0);
            }

            // Greedy longest-processing-time packing: the cards arrive largest
            // first, so drop each into whichever column is currently shortest.
            // Dealing them round robin would give column one the largest of every
            // group, so it would always finish tallest. The weight is estimated
            // from the row count rather than measured, so this never reads back
            // layout and never waits on webfonts or icons.
            // appendChild moves each card out of its old column.
            ordered.forEach(function (card) {
                var shortest = 0;
                for (var c = 1; c < target; c++) {
                    if (weights[c] < weights[shortest]) shortest = c;
                }

                columns[shortest].appendChild(card);
                weights[shortest] += parseInt(card.getAttribute('data-weight'), 10) || 1;
            });

            container.innerHTML = '';
            columns.forEach(function (column) { container.appendChild(column); });
        }

        // Deal now, synchronously. This needs no jQuery, only the dom, and the
        // cards above are already parsed, so the columns are right before the
        // first paint. Waiting for the bundle would show one tall stack that
        // then snapped into columns.
        redeal();

        // The filter does need jQuery, which the hub layout loads asynchronously
        // through requirejs while this package's own layout uses a plain script
        // tag. Polling for it works under both.
        (function boot(attempt) {
            if (typeof window.jQuery === 'undefined') {
                if (attempt < 200) setTimeout(function () { boot(attempt + 1); }, 50);
                return;
            }

            var $ = window.jQuery;

            // Re-runs on every olive ajax re-render of this module, so handlers are
            // namespaced and torn down first to keep re-entry idempotent.
            var NS = '.everythingSearch';
            var $doc = $(document);
            $doc.off(NS);

            var resizeTimer;
            $(window).off(NS).on('resize' + NS, function () {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(redeal, 150);
            });

            // Urls are kebab-case ("/people/absence-requests") while titles are spaced
            // ("Absence Requests"), and the logical path is separated by ">". Fold all
            // of those to spaces on both sides of the comparison so that any of
            // "absence requests", "absence-requests" and "people/absence" match.
            var SEPARATORS = /[\s\-_\/>]+/g;

            function normalise(text) {
                return text.toLowerCase().replace(SEPARATORS, ' ');
            }

            function terms() {
                return normalise($('#FeatureSearch').val() || '').trim().split(' ').filter(Boolean);
            }

            function matches(hay, words) {
                return words.every(function (w) { return hay.indexOf(w) !== -1; });
            }

            // Searchable text for a card or a row: its logical path (or title) plus
            // its url, so "people/absence" and "absence" both find the same feature.
            function haystack(el, title) {
                return normalise((title || el.getAttribute('data-path') || '') + ' ' +
                                 (el.getAttribute('data-url') || ''));
            }

            function highlight(el, words) {
                var text = el.getAttribute('data-title') || el.textContent;
                if (!words.length) { el.textContent = text; return; }

                var pattern = words.map(function (w) { return w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }).join('|');
                var re = new RegExp('(' + pattern + ')', 'ig');

                el.textContent = '';
                var last = 0, match;
                while ((match = re.exec(text)) !== null) {
                    if (re.lastIndex === match.index) { re.lastIndex++; continue; }
                    el.appendChild(document.createTextNode(text.slice(last, match.index)));
                    el.appendChild($('<mark/>').text(match[0])[0]);
                    last = match.index + match[0].length;
                }
                el.appendChild(document.createTextNode(text.slice(last)));
            }

            function apply() {
                var words = terms();
                var $items = $('.everything-item');
                var $cols = $('.everything-group');
                var shownItems = 0;

                $items.each(function () {
                    var hit = matches(haystack(this), words);
                    this.hidden = !hit;
                    if (hit) shownItems++;
                });

                $cols.each(function () {
                    var $col = $(this);
                    var title = $col.find('.everything-group-title').attr('data-title') || '';
                    var visible = $col.find('.everything-item:not([hidden])').length;

                    this.hidden = !(!words.length || visible > 0 || matches(haystack(this, title), words));

                    // Otherwise a filtered card claims "6" while showing one row.
                    var $badge = $col.find('.card-header .badge[data-total]');
                    if ($badge.length) $badge.text(words.length ? visible : $badge.attr('data-total'));
                });

                $('.everything-title, .everything-group-title').each(function () { highlight(this, words); });

                // A top level group is itself a feature, so it counts alongside the rows.
                var total = $items.length + $cols.length;
                var shown = shownItems + $cols.not('[hidden]').length;

                $('.everything-count').text(words.length
                    ? 'Showing ' + shown + ' of ' + total + ' features'
                    : total + ' features');
                $('.everything-clear').prop('hidden', !words.length);
                $('.everything-empty-term').text('"' + $('#FeatureSearch').val() + '"');
                $('.everything-empty').prop('hidden', !(words.length && shown === 0));
            }

            var timer;
            $doc.on('input' + NS, '#FeatureSearch', function () {
                clearTimeout(timer);
                timer = setTimeout(apply, 120);
            });

            // Stop Enter from posting the form, as olive's own InstantSearch plugin does.
            $doc.on('keydown' + NS, '#FeatureSearch', function (e) { if (e.keyCode === 13) e.preventDefault(); });

            $doc.on('click' + NS, '.everything-clear', function () {
                clearTimeout(timer);
                $('#FeatureSearch').val('');
                apply();
            });

            apply();
        })(0);
    })();
    </script>
</form>
<!-- «End| EverythingPage_Everything» -->
